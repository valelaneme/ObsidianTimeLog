<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== 底层：单日分析首页 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 顶栏：左侧菜单，日期居中（点它弹日期选择器），右侧回到今天 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="设置"
                android:padding="10dp"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/tvStatsDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:text="录入日期：—"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnBackToday"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="回到今天"
                android:padding="10dp"
                android:src="@drawable/ic_today" />
        </FrameLayout>

        <!-- 内容区：两页并排，底层是相邻日期的预览页，滑动时从侧边露出来 -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- 相邻日期预览页：左右滑动时从侧边露出，避免白边（平时隐藏）。
                 结构和下面的真页 contentRoot 保持一致，滑过来看到的就是完整内容，不再"空页→刷新"。 -->
            <LinearLayout
                android:id="@+id/neighborPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="?android:attr/windowBackground"
                android:visibility="gone"
                android:paddingTop="0dp">

                <com.example.timelog.ui.TimelineView
                    android:id="@+id/neighborTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="2dp"
                    android:text="颜色＝一级分类　红条＝重叠　灰底＝未记录　蓝线＝现在　黑线＝6/12/18点"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nbStatRecord"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="—"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="记录时间"
                            android:textColor="#5F6368"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nbStatUnrecorded"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="—"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="未记录"
                            android:textColor="#5F6368"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nbStatCoverage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="—"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="覆盖率"
                            android:textColor="#5F6368"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/nbStatCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="—"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="记录条数"
                            android:textColor="#5F6368"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/nbLevel1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text=""
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/nbWarnings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:visibility="gone"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/nbRecordsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/contentScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

            <!-- 内容根：翻日期时整体做一个小幅位移动画（只动这一个容器，开销很小） -->
            <LinearLayout
                android:id="@+id/contentRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/windowBackground"
                android:orientation="vertical">

                <!-- 24 小时时间轴：颜色=一级分类，红条=重叠，灰底=空白，蓝线=现在 -->
                <!-- 色带本身 20dp 高，刻度改成黑线直接画在色带上，不再占下方空间 -->
                <com.example.timelog.ui.TimelineView
                    android:id="@+id/timeline"
                    android:layout_width="match_parent"
                    android:layout_height="26dp"
                    android:layout_marginTop="6dp"
                    android:contentDescription="当天时间轴" />

                <TextView
                    android:id="@+id/tvTimelineLegend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="2dp"
                    android:text="颜色＝一级分类　红条＝重叠　灰底＝未记录　蓝线＝现在　黑线＝6/12/18点"
                    android:textSize="11sp" />

                <!-- 四项统计排成一行：记录时间 / 未记录 / 覆盖率 / 条数 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatRecord"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="—"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="记录时间"
                            android:textColor="#5F6368"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatUnrecorded"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="—"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="未记录"
                            android:textColor="#5F6368"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatCoverage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="—"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="覆盖率"
                            android:textColor="#5F6368"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatCount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="—"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="记录条数"
                            android:textColor="#5F6368"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 一级分类（保留）。二级分类不再单独列出 -->
                <TextView
                    android:id="@+id/tvLevel1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text=""
                    android:textIsSelectable="true"
                    android:textSize="13sp" />

                <!-- 解析提示：有才显示，没有就整块隐藏 -->
                <TextView
                    android:id="@+id/tvWarnings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:visibility="gone"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />

                <!-- 按时间顺序逐条列出；两条不相连时中间插半行高的空档 -->
                <LinearLayout
                    android:id="@+id/recordsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="4dp" />

                <TextView
                    android:id="@+id/tvCheckTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="14dp"
                    android:text="重叠校验"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="4dp"
                    android:text=""
                    android:textIsSelectable="true"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <!-- 底部三按钮：单手拇指可及 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btnStopwatch"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="⏱ 正计时" />

            <Button
                android:id="@+id/btnInput"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="✎ 录入" />

            <Button
                android:id="@+id/btnCountdown"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="⏳ 倒计时" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 录入浮层（BottomSheet）：半屏、可收起 ===== -->
    <View
        android:id="@+id/sheetDim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/inputSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFFFF"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 把手：点它或下滑收起 -->
        <LinearLayout
            android:id="@+id/sheetHandle"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSheetTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:text="录入（下滑或点「返回」退出）"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHideSheet"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:text="返回"
                android:textSize="12sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/sheetScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="日期 YYYY-MM-DD"
                        android:inputType="date" />

                    <Button
                        android:id="@+id/btnToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今天" />

                    <Button
                        android:id="@+id/btnGoDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="查看" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="开始 09:00"
                        android:inputType="time" />

                    <Button
                        android:id="@+id/btnNowStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="现在" />

                    <EditText
                        android:id="@+id/etEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="结束 10:30"
                        android:inputType="time" />

                    <Button
                        android:id="@+id/btnNowEnd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="现在" />
                </LinearLayout>

                <!-- 快捷时间：手打最少 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRoundStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="开始整点"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnRoundEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="结束整点"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnHalfEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="结束半点"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnClearTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="清空"
                        android:textSize="11sp" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etL1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="一级分类（如 家务）"
                    android:inputType="text" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/l1CandidatesRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/etL2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="二级分类（如 做饭，可留空）"
                    android:inputType="text" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/l2CandidatesRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="事项（如 早餐，可留空）"
                    android:inputType="text" />

                <EditText
                    android:id="@+id/etLinks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="双链（空格分隔，如 地点 张老师）"
                    android:inputType="text" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/linkCandidatesRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/etNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="备注（可留空）"
                    android:inputType="textMultiLine"
                    android:maxLines="2" />

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="校验并追加到当天 md" />

                <!-- 只有在「点记录进来编辑」时才显示 -->
                <Button
                    android:id="@+id/btnSheetDelete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="删除这条记录"
                    android:textColor="#C5221F"
                    android:visibility="gone" />

                <CheckBox
                    android:id="@+id/cbContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="保存后继续录下一段（开始时间接上一段）"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:text="预览会显示在这里"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
